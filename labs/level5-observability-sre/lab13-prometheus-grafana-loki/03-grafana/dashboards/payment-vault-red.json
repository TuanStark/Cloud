        {
            "id": 1,
            "title": "📈 Request Rate (RPS)",
            "type": "timeseries",
            "gridPos": {
                "h": 8,
                "w": 8,
                "x": 0,
                "y": 1
            },
            "datasource": {
                "type": "prometheus",
                "uid": "Prometheus"
            },
            "targets": [
                {
                    "expr": "sum(rate(http_requests_total{app=\"payment-vault\"}[1m]))",
                    "legendFormat": "Total RPS"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "custom": {
                        "drawStyle": "line",
                        "lineInterpolation": "smooth",
                        "fillOpacity": 15
                    },
                    "unit": "reqps"
                }
            }
        },
        {
            "id": 2,
            "title": "🚨 Error Rate (%)",
            "type": "timeseries",
            "gridPos": {
                "h": 8,
                "w": 8,
                "x": 8,
                "y": 1
            },
            "datasource": {
                "type": "prometheus",
                "uid": "Prometheus"
            },
            "targets": [
                {
                    "expr": "(sum(rate(http_requests_total{app=\"payment-vault\",status=~\"5..\"}[1m])) or vector(0)) / (sum(rate(http_requests_total{app=\"payment-vault\"}[1m])) or vector(1)) * 100",
                    "legendFormat": "5xx Error %"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "custom": {
                        "drawStyle": "line",
                        "lineInterpolation": "smooth",
                        "fillOpacity": 20
                    },
                    "unit": "percent",
                    "color": {
                        "mode": "thresholds"
                    },
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "green",
                                "value": null
                            },
                            {
                                "color": "red",
                                "value": 5
                            }
                        ]
                    }
                }
            }
        },
        {
            "id": 3,
            "title": "⏱️ Latency Distribution (Duration)",
            "type": "timeseries",
            "gridPos": {
                "h": 8,
                "w": 8,
                "x": 16,
                "y": 1
            },
            "datasource": {
                "type": "prometheus",
                "uid": "Prometheus"
            },
            "targets": [
                {
                    "expr": "histogram_quantile(0.50, sum(rate(http_request_duration_seconds_bucket{app=\"payment-vault\"}[1m])) by (le))",
                    "legendFormat": "P50 (Median)"
                },
                {
                    "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{app=\"payment-vault\"}[1m])) by (le))",
                    "legendFormat": "P95 (Tail Latency)"
                },
                {
                    "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket{app=\"payment-vault\"}[1m])) by (le))",
                    "legendFormat": "P99 (Worst Case)"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "custom": {
                        "drawStyle": "line",
                        "lineInterpolation": "smooth"
                    },
                    "unit": "s"
                }
            }
        }
    ],
